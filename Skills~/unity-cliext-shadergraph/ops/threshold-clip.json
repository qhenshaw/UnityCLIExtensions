[
  {"op":"set_target","setting":"alphaClip","value":"true"},
  {"op":"add_property","type":"float","name":"Amount","reference":"_Amount","value":"0","as":"amount"},
  {"op":"add_property","type":"float","name":"Edge Width","reference":"_EdgeWidth","value":"0.05","as":"edgeWidth"},
  {"op":"add_property","type":"color","name":"Edge Color","reference":"_EdgeColor","value":"[1,0.4,0.1,1]","as":"edgeColor"},
  {"op":"add_property","type":"texture2d","name":"Mask","reference":"_MaskTex","value":"Assets/REPLACE/WithYourTexture.png","as":"maskTex"},
  {"op":"set_mode","id":"_Amount","mode":"slider","min":0,"max":1},
  {"op":"set_mode","id":"_EdgeColor","mode":"hdr"},
  {"op":"add_node","type":"Input/Texture/Sample Texture 2D","as":"mask"},
  {"op":"link","from":"$maskTex","to":"$mask:Texture"},
  {"op":"add_block","block":"Alpha","as":"alpha"},
  {"op":"add_block","block":"Alpha Clip Threshold","as":"clip"},
  {"op":"link","from":"$mask:R","to":"$alpha:0"},
  {"op":"link","from":"$amount","to":"$clip:0"},
  {"op":"add_node","type":"Math/Basic/Add","as":"edgeEnd"},
  {"op":"link","from":"$amount","to":"$edgeEnd:A"},
  {"op":"link","from":"$edgeWidth","to":"$edgeEnd:B"},
  {"op":"add_node","type":"Math/Round/Step","as":"edgeBand"},
  {"op":"link","from":"$mask:R","to":"$edgeBand:Edge"},
  {"op":"link","from":"$edgeEnd:Out","to":"$edgeBand:In"},
  {"op":"add_node","type":"Math/Basic/Multiply","as":"edgeGlow"},
  {"op":"link","from":"$edgeColor","to":"$edgeGlow:A"},
  {"op":"link","from":"$edgeBand:Out","to":"$edgeGlow:B"},
  {"op":"add_block","block":"Emission","as":"emission"},
  {"op":"link","from":"$edgeGlow:Out","to":"$emission:0"}
]
